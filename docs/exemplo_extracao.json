  "chunks": [
    {
      "id": "12345_0",
      "ordem": 0,
      "texto": "Dennis Ritchie (1941-2011) foi um cientista da computação norte-americano. Trabalhou no Bell Labs, onde criou a linguagem C no início da década de 1970, a partir da linguagem B."
    },
    {
      "id": "12345_1",
      "ordem": 1,
      "texto": "Junto com Ken Thompson, Ritchie desenvolveu o sistema operacional Unix, que foi reescrito em C e executado no PDP-11. Em 1983, os dois receberam o Prêmio Turing."
    }
  ],
